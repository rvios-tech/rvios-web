# متغيّرات NEXT_PUBLIC_* تُخبز وقت البناء — اضبطها في الاستضافة قبل البناء.

# الباكند الموحّد (F:\RVIOS_APP\api) بالبادئة /api/v1 — يحفظ رسائل نموذج التواصل
# في AzmSmart (الموقع ← الرسائل). أصل هذا الموقع يجب أن يكون في CORS_ORIGINS هناك.
NEXT_PUBLIC_UNIFIED_API_URL=http://localhost:3002/api/v1

# روابط المنتجين (https في الإنتاج)
NEXT_PUBLIC_STOREOS_URL=https://store.rvios.com
NEXT_PUBLIC_AZMSMART_URL=https://azm.rvios.com

# إرسال نسخة بريدية من رسائل التواصل عبر Resend (اختياري)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@rvios.com
